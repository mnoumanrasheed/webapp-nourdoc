# For a LOCAL DEMO only. Do not expose demo mode or sample accounts in a real hospital deployment.
DEMO_MODE=true
NEXT_PUBLIC_DATA_MODE=mock
# Replace with a random secret containing at least 32 characters.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARACTERS_MINIMUM

# Run `npm run setup:demo-auth` to write real local values to ignored .env.local.
# Password hashes use Node scrypt with a unique salt per account. Never commit passwords.
DEMO_ADMIN_EMAIL=admin@nourdoc.local
DEMO_ADMIN_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_SETUP_DEMO_AUTH
DEMO_DOCTOR_A_EMAIL=ahmed@nourdoc.local
DEMO_DOCTOR_A_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_SETUP_DEMO_AUTH
DEMO_DOCTOR_B_EMAIL=sara@nourdoc.local
DEMO_DOCTOR_B_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_SETUP_DEMO_AUTH
